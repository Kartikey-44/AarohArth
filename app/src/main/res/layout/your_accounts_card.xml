<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    android:id="@+id/card"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:backgroundTint="@color/your_account_card_bg"
    app:strokeColor="@color/your_account_card_stroke"
    app:strokeWidth="3dp"
    android:elevation="10dp"
    android:layout_margin="10dp"
    app:cardCornerRadius="25dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent">
        <ImageView
            android:id="@+id/icon_container"
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_margin="20dp"
            android:background="@drawable/icon_container_bg"
            android:src="@drawable/upi"
            android:padding="10dp"/>
        <TextView
            android:id="@+id/your_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Balance:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/your_account_balance_label"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/icon_container"
            android:layout_marginTop="20dp"
            android:layout_marginStart="10dp"/>

        <TextView
            android:id="@+id/balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹ 85,84,75,85,893"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/your_account_amount"
            app:layout_constraintTop_toTopOf="@id/your_balance"
            app:layout_constraintStart_toEndOf="@id/your_balance"
            android:layout_marginStart="12dp"/>

        <TextView
            android:id="@+id/account_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Type:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/your_account_text_secondary"
            app:layout_constraintTop_toBottomOf="@id/balance"
            app:layout_constraintStart_toEndOf="@id/icon_container"
            android:layout_marginTop="8dp"
            android:layout_marginStart="10dp"/>

        <TextView
            android:id="@+id/type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UPI"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/your_account_text_primary"
            app:layout_constraintTop_toTopOf="@id/account_type"
            app:layout_constraintStart_toEndOf="@id/account_type"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/account_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Name:"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/your_account_text_secondary"
            app:layout_constraintTop_toBottomOf="@id/account_type"
            app:layout_constraintStart_toEndOf="@id/icon_container"
            android:layout_marginTop="6dp"
            android:layout_marginStart="10dp"/>

        <TextView
            android:id="@+id/name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="G-Pay"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/your_account_text_primary"
            app:layout_constraintTop_toTopOf="@id/account_name"
            app:layout_constraintStart_toEndOf="@id/account_name"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="20dp"
            android:maxLines="2"
            android:ellipsize="end"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>