<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeFragement">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:text="Good Afternoon,"
            android:gravity="start"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="20dp"
            android:textSize="18sp"
            android:textColor="@color/recent_transaction" />
        <TextView
            android:id="@+id/username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/greeting"
            app:layout_constraintStart_toStartOf="parent"
            android:text="Kartikey Kumar Pandey"
            android:gravity="start"
            android:layout_marginTop="4dp"
            android:layout_marginStart="40dp"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/recent_transaction" />

        <ImageView
            android:id="@+id/notification"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/notificationbg"
            android:src="@drawable/nonotification"
            app:layout_constraintBottom_toTopOf="@id/this_month_overview"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:padding="12dp"/>

        <TextView
            android:id="@+id/this_month_overview"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/username"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/income_card"
            android:text="This Month Overview"
            android:textSize="18sp"
            android:layout_marginVertical="10dp"
            android:gravity="center"
            android:textColor="@color/this_month_overview_expense" />
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/income_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/this_month_overview"
            app:layout_constraintEnd_toStartOf="@+id/expense_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/current_balance_card"
            android:layout_marginHorizontal="20dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/icon_stroke_overview">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/income_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="5dp"
                    android:layout_margin="5dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:background="@drawable/icon_bg_overview_card"
                    android:src="@drawable/income"/>
                <TextView
                    android:id="@+id/income_heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@id/income_icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:textSize="14dp"
                    android:text="Income"
                    android:gravity="center"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/overview_cards_label"/>
                <TextView
                    android:id="@+id/income_amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/income_icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/income_heading"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:text="50,000"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:layout_marginBottom="10dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/overview_cards_amount"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/expense_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/this_month_overview"
            app:layout_constraintStart_toEndOf="@id/income_card"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="10dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/icon_stroke_overview">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/expense_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_margin="5dp"
                    android:background="@drawable/icon_bg_overview_card"
                    android:padding="5dp"
                    android:src="@drawable/expense"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/expense_heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="Expense"
                    android:textColor="@color/overview_cards_label"
                    android:textSize="14dp"
                    app:layout_constraintStart_toEndOf="@id/expense_icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/expense_amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toEndOf="@id/expense_icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/expense_heading"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:text="50,000"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:layout_marginBottom="10dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/overview_cards_amount"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/current_balance_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/income_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="20dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:id="@+id/current_balance_heading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:text="Current Balance:"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:textColor="@color/overview_cards_label"/>
                <TextView
                    android:id="@+id/current_balance_amount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/current_balance_heading"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:gravity="center"
                    android:text="40,0000000"
                    android:textSize="24sp"
                    android:textColor="@color/overview_cards_amount"
                    android:layout_marginTop="5dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
           android:id="@+id/account_manage"
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           app:layout_constraintTop_toBottomOf="@id/current_balance_card"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintEnd_toStartOf="@id/budget_manage"
           android:layout_marginTop="20dp"
           android:layout_marginHorizontal="20dp"
           android:backgroundTint="@color/managemnt_card_back"
           app:strokeColor="@color/management_stroke_color"
           app:strokeWidth="1.5dp"
           app:cardCornerRadius="30dp">
           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="match_parent"
               android:orientation="horizontal">
               <ImageView
                   android:layout_width="50dp"
                   android:layout_height="50dp"
                   android:layout_margin="10dp"
                   android:src="@drawable/bank"
                   android:padding="10dp"
                   android:background="@drawable/homefragiconbg"
                   />
               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="match_parent"
                   android:text="@string/manageAccounts"
                   android:textStyle="bold"
                   android:textColor="@color/management_text_color"
                   android:textSize="16sp"
                   android:gravity="center"/>

           </LinearLayout>

       </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/budget_manage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/current_balance_card"
            app:layout_constraintStart_toEndOf="@id/account_manage"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp"
            android:backgroundTint="@color/managemnt_card_back"
            app:strokeColor="@color/management_stroke_color"
            app:strokeWidth="1.5dp"
            app:cardCornerRadius="30dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_margin="10dp"
                    android:src="@drawable/budget"
                    android:padding="10dp"
                    android:background="@drawable/homefragiconbg"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/manageBudgets"
                    android:textStyle="bold"
                    android:textColor="@color/management_text_color"
                    android:textSize="16sp"
                    android:gravity="center"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>






        <TextView
            android:id="@+id/recent_transaction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/account_manage"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="20dp"
            android:text="Recent Transactions"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginHorizontal="20dp"
            android:textColor="@color/recent_transaction"/>
        <TextView
            android:id="@+id/see_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/budget_manage"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="See All"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginHorizontal="20dp"
            android:textColor="@color/recent_transaction"
            android:clickable="true"
            />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tran_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/recent_transaction"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="15dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/add_transaction_Btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:contentDescription="@string/app_ai"
            android:focusable="true"
            android:src="@drawable/plus_icon"
            app:backgroundTint="@color/colorOnAddTransactionBtn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:shapeAppearanceOverlay="@style/RoundCorner"
            app:tint="@color/colorAddTransactionBtn" />
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/ai_Btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:contentDescription="@string/app_ai"
            android:padding="10dp"
            android:focusable="true"
            android:src="@drawable/ai"
            android:visibility="invisible"
            app:backgroundTint="@color/colorOnAiButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/add_transaction_Btn"
            app:maxImageSize="45dp"
            app:shapeAppearanceOverlay="@style/RoundCorner"
            app:tint="@color/colorAiButton" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/expense_Btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:contentDescription="@string/expense_Btn"
            android:focusable="true"
            android:src="@drawable/expense"
            android:visibility="invisible"
            app:backgroundTint="@color/colorExpenseButton"
            app:layout_constraintBottom_toTopOf="@+id/add_transaction_Btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/colorOnExpenseButton" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/income_Btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:contentDescription="@string/income_btn"
            android:focusable="true"
            android:src="@drawable/income"
            android:visibility="invisible"
            app:backgroundTint="@color/colorIncomeButton"
            app:layout_constraintBottom_toTopOf="@+id/expense_Btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/colorOnIncomeButton" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>