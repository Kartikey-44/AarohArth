<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeFragement">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/top_card"
            android:layout_width="0dp"
            android:layout_height="200dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="95dp"
            app:cardCornerRadius="25dp"
            android:backgroundTint="@color/top_card_back_profit"
            app:strokeColor="@color/top_card_stroke_profit"
            app:strokeWidth="4dp"
            app:cardElevation="10dp"
            android:layout_marginHorizontal="10dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                >

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

       <com.google.android.material.card.MaterialCardView
           android:id="@+id/account_manage"
           android:layout_width="0dp"
           android:layout_height="wrap_content"
           app:layout_constraintTop_toBottomOf="@id/top_card"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintEnd_toStartOf="@id/loan_manage"
           android:layout_marginTop="20dp"
           android:layout_marginHorizontal="20dp"
           android:backgroundTint="@color/managemnt_card_back"
           app:strokeColor="@color/management_stroke_color"
           app:strokeWidth="2dp"
           app:cardCornerRadius="30dp">
           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="match_parent"
               android:orientation="horizontal">
               <ImageView
                   android:layout_width="50dp"
                   android:layout_height="50dp"
                   android:layout_margin="10dp"
                   android:src="@drawable/bank"
                   android:padding="10dp"
                   android:background="@drawable/homefragiconbg"
                   />
               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="match_parent"
                   android:text="@string/manageAccounts"
                   android:textStyle="bold"
                   android:textColor="@color/management_text_color"
                   android:textSize="16sp"
                   android:gravity="center"/>

           </LinearLayout>

       </com.google.android.material.card.MaterialCardView>


        <com.google.android.material.card.MaterialCardView
            android:id="@+id/loan_manage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/top_card"
            app:layout_constraintStart_toEndOf="@id/account_manage"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp"
            android:layout_marginHorizontal="20dp"
            android:backgroundTint="@color/managemnt_card_back"
            app:strokeColor="@color/management_stroke_color"
            app:strokeWidth="2dp"
            app:cardCornerRadius="30dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_margin="10dp"
                    android:src="@drawable/budget"
                    android:padding="10dp"
                    android:background="@drawable/homefragiconbg"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/manageBudgets"
                    android:textStyle="bold"
                    android:textColor="@color/management_text_color"
                    android:textSize="16sp"
                    android:gravity="center"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>






        <TextView
            android:id="@+id/recent_transaction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/account_manage"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="20dp"
            android:text="Recent Transactions"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginHorizontal="20dp"
            android:textColor="@color/recent_transaction"/>
        <TextView
            android:id="@+id/see_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/loan_manage"
            android:layout_marginTop="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            android:text="See All"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginHorizontal="20dp"
            android:textColor="@color/recent_transaction"
            android:clickable="true"
            />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/tran_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/recent_transaction"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginTop="10dp"
            android:layout_marginHorizontal="15dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/add_transaction_Btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:contentDescription="@string/app_ai"
            android:focusable="true"
            android:src="@drawable/plus_icon"
            app:backgroundTint="@color/colorOnAddTransactionBtn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:shapeAppearanceOverlay="@style/RoundCorner"
            app:tint="@color/colorAddTransactionBtn" />
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/ai_Btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:contentDescription="@string/app_ai"
            android:padding="10dp"
            android:focusable="true"
            android:src="@drawable/ai"
            android:visibility="invisible"
            app:backgroundTint="@color/colorOnAiButton"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/add_transaction_Btn"
            app:maxImageSize="45dp"
            app:shapeAppearanceOverlay="@style/RoundCorner"
            app:tint="@color/colorAiButton" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/expense_Btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:clickable="true"
            android:contentDescription="@string/expense_Btn"
            android:focusable="true"
            android:src="@drawable/expense_graph_icon"
            android:visibility="invisible"
            app:backgroundTint="@color/colorExpenseButton"
            app:layout_constraintBottom_toTopOf="@+id/add_transaction_Btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/colorOnExpenseButton" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/income_Btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:contentDescription="@string/income_btn"
            android:focusable="true"
            android:src="@drawable/income_graph_icon"
            android:visibility="invisible"
            app:backgroundTint="@color/colorIncomeButton"
            app:layout_constraintBottom_toTopOf="@+id/expense_Btn"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/colorOnIncomeButton" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>