<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AccountManagement"
    android:background="@color/screen_background">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/addBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="50dp"
        android:layout_marginHorizontal="20dp"
        android:backgroundTint="@color/saveBtnBg"
        app:cornerRadius="25dp"
        app:strokeColor="@color/saveBtnStroke"
        app:strokeWidth="2dp"
        android:text="Tap To Add Account"
        android:textColor="@color/saveBtnText"
        android:textSize="25sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="8dp"/>
    <TextView
        android:id="@+id/your_accounts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/addBtn"
        android:layout_margin="15dp"
        android:textSize="30sp"
        android:text="Your Accounts"
        android:gravity="center"
        android:textStyle="bold"
        android:textColor="@color/yourAccounts"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/yourAccountsList"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/your_accounts"
        android:layout_margin="15dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>


</androidx.constraintlayout.widget.ConstraintLayout>