    <style name="Theme.AarohArth" parent="Base.Theme.AarohArth" />

    <style name="RoundCorner" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">45dp</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="app.CustomIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#228B22</item>
    </style>

    <style name="CircleImageOverlay" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CircleBorderOverlay" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="AppTheme.PopupOverlay" parent="">
        <item name="android:popupBackground">@android:color/transparent</item>
    </style>

</resources>